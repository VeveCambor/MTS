# Supabase – zkopíruj do .env.local (lokálně) nebo do Vercel Environment Variables (produkce)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Pouze lokálně pro seed skript – NIKDY na Vercel, NIKDY do klienta
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Volitelné (v aplikaci zatím nepoužito)
# NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Vercel: nastav jen tyto 2 proměnné ---
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY
# Podrobnosti: DEPLOY.md
