# Supabase – zkopíruj do .env.local (lokálně) nebo do Vercel Environment Variables (produkce)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Pouze lokálně pro seed skript – NIKDY na Vercel, NIKDY do klienta
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL aplikace — povinné na Vercel (redirect v potvrzovacím e-mailu po registraci)
# Lokálně volitelné (fallback: aktuální origin / localhost:3002)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Vercel: nastav tyto 3 proměnné ---
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY
# NEXT_PUBLIC_SITE_URL=https://<tvuj-projekt>.vercel.app
# Podrobnosti: DEPLOY.md
